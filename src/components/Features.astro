---
const features = [
  {
    title: "Train on Documents",
    description: "Upload PDFs, DOCs, CSVs, and more. Our AI learns from your existing documentation.",
  },
  {
    title: "Train on APIs & Databases",
    description: "Connect your REST APIs and databases for real-time, accurate responses.",
  },
  {
    title: "Embeddable Chat Widget",
    description: "A beautiful, customizable chat widget that matches your brand perfectly.",
  },
  {
    title: "Real-time Sync",
    description: "Your chatbot stays up-to-date as your data changes. No manual retraining needed.",
  },
  {
    title: "Secure & Private",
    description: "Enterprise-grade security with end-to-end encryption. Your data stays yours.",
  },
  {
    title: "No-code Setup",
    description: "Get started in minutes without writing a single line of code.",
  },
];
---

<section id="features" class="section-padding bg-[var(--color-background)]">
  <div class="container-narrow mx-auto">
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="heading-lg mb-4">
        Everything You Need to <span class="gradient-text">Build Smart Support</span>
      </h2>
      <p class="body-lg max-w-2xl mx-auto">
        Powerful features that make creating and managing your AI chatbot effortless.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Train on Documents -->
      <div class="group animate-on-scroll delay-100">
        <div class="glass-card rounded-2xl p-6 h-full hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors duration-300">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
          </div>
          <h3 class="heading-md mb-2">{features[0].title}</h3>
          <p class="body-md">{features[0].description}</p>
        </div>
      </div>

      <!-- Train on APIs & Databases -->
      <div class="group animate-on-scroll delay-200">
        <div class="glass-card rounded-2xl p-6 h-full hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors duration-300">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
            </svg>
          </div>
          <h3 class="heading-md mb-2">{features[1].title}</h3>
          <p class="body-md">{features[1].description}</p>
        </div>
      </div>

      <!-- Embeddable Chat Widget -->
      <div class="group animate-on-scroll delay-300">
        <div class="glass-card rounded-2xl p-6 h-full hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors duration-300">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
            </svg>
          </div>
          <h3 class="heading-md mb-2">{features[2].title}</h3>
          <p class="body-md">{features[2].description}</p>
        </div>
      </div>

      <!-- Real-time Sync -->
      <div class="group animate-on-scroll delay-100">
        <div class="glass-card rounded-2xl p-6 h-full hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors duration-300">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
            </svg>
          </div>
          <h3 class="heading-md mb-2">{features[3].title}</h3>
          <p class="body-md">{features[3].description}</p>
        </div>
      </div>

      <!-- Secure & Private -->
      <div class="group animate-on-scroll delay-200">
        <div class="glass-card rounded-2xl p-6 h-full hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors duration-300">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="heading-md mb-2">{features[4].title}</h3>
          <p class="body-md">{features[4].description}</p>
        </div>
      </div>

      <!-- No-code Setup -->
      <div class="group animate-on-scroll delay-300">
        <div class="glass-card rounded-2xl p-6 h-full hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          <div class="w-12 h-12 rounded-xl bg-blue-100 flex items-center justify-center mb-4 group-hover:bg-blue-200 transition-colors duration-300">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="heading-md mb-2">{features[5].title}</h3>
          <p class="body-md">{features[5].description}</p>
        </div>
      </div>
    </div>
  </div>
</section>
