---
const aiLogos = [
  { name: "ChatGPT", icon: "🤖" },
  { name: "Claude", icon: "✨" },
  { name: "Gemini", icon: "💎" },
  { name: "Perplexity", icon: "🔮" },
];
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-black blueprint-grid">
  <!-- Background effects -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-green-500/10 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px]"></div>
  </div>

  <!-- Vertical dashed lines (blueprint effect) -->
  <div class="absolute inset-0 pointer-events-none opacity-30">
    <div class="h-full w-px border-l border-dashed border-zinc-700 absolute left-1/4"></div>
    <div class="h-full w-px border-l border-dashed border-zinc-700 absolute left-1/2"></div>
    <div class="h-full w-px border-l border-dashed border-zinc-700 absolute left-3/4"></div>
  </div>

  <div class="container-narrow mx-auto px-4 md:px-8 pt-48 pb-20 relative z-10">
    <!-- Centered Hero Content -->
    <div class="text-center max-w-4xl mx-auto mb-16 animate-on-scroll">
      <h1 class="heading-xl mb-6">
        Build AI Chatbots for
        <br />
        <span id="rotating-text" class="gradient-text inline-block min-w-[200px]">Support Teams</span>
      </h1>

      <p class="body-lg mb-10 max-w-2xl mx-auto text-zinc-400">
        Create custom AI chatbots for customer support and internal teams. Train on your data and embed anywhere in minutes.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#book-demo" class="btn-hero">
          Get a Demo
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a href="#how-it-works" class="btn-hero-outline">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          See How It Works
        </a>
      </div>
    </div>

    <!-- macOS Window Chat Preview -->
    <div class="max-w-2xl mx-auto animate-on-scroll delay-200">
      <div class="relative">
        <!-- Glow effect -->
        <div class="absolute -inset-4 bg-gradient-to-r from-green-500/20 to-blue-500/20 rounded-2xl blur-2xl opacity-50"></div>
        
        <!-- macOS Window -->
        <div class="relative macos-window glow-effect">
          <!-- Title bar -->
          <div class="macos-titlebar">
            <div class="macos-dot macos-dot-red"></div>
            <div class="macos-dot macos-dot-yellow"></div>
            <div class="macos-dot macos-dot-green"></div>
            <span class="ml-4 text-sm text-zinc-500">UniBot Assistant</span>
            <div class="ml-auto flex items-center gap-2">
              <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
              <span class="text-xs text-zinc-500">Online</span>
            </div>
          </div>

          <!-- Chat content -->
          <div class="p-6 space-y-4">
            <!-- User message -->
            <div class="flex justify-end animate-on-scroll delay-300">
              <div class="bg-zinc-800 rounded-2xl rounded-tr-sm px-4 py-3 max-w-[80%]">
                <p class="text-sm text-white">How do I integrate your API with my platform?</p>
              </div>
            </div>

            <!-- Bot response -->
            <div class="flex justify-start animate-on-scroll delay-400">
              <div class="bg-zinc-900 border border-zinc-800 rounded-2xl rounded-tl-sm px-4 py-3 max-w-[80%]">
                <p class="text-sm text-zinc-300 mb-2">
                  Great question! Here's how to integrate our API:
                </p>
                <ol class="text-sm text-zinc-500 space-y-1">
                  <li>1. Generate an API key from your dashboard</li>
                  <li>2. Install our SDK: <code class="text-green-400">npm install unibot-sdk</code></li>
                  <li>3. Initialize with your key...</li>
                </ol>
              </div>
            </div>

            <!-- User message -->
            <div class="flex justify-end animate-on-scroll delay-500">
              <div class="bg-zinc-800 rounded-2xl rounded-tr-sm px-4 py-3 max-w-[80%]">
                <p class="text-sm text-white">That's exactly what I needed! 🎉</p>
              </div>
            </div>
          </div>

          <!-- Input area -->
          <div class="px-6 pb-6">
            <div class="flex items-center gap-3 bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3">
              <svg class="w-5 h-5 text-zinc-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
              </svg>
              <span class="text-sm text-zinc-600">Type your message...</span>
              <button class="ml-auto p-2 bg-green-500 rounded-lg hover:bg-green-400 transition-colors">
                <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Trust indicators -->
    <div class="mt-20 text-center animate-on-scroll delay-300">
      <p class="text-sm text-zinc-600 mb-6">Trusted by innovative companies worldwide</p>
      <div class="flex items-center justify-center gap-12 opacity-40">
        <span class="text-lg font-semibold text-zinc-500">Acme Inc</span>
        <span class="text-lg font-semibold text-zinc-500">TechCorp</span>
        <span class="text-lg font-semibold text-zinc-500">StartupXY</span>
        <span class="text-lg font-semibold text-zinc-500 hidden md:block">DataFlow</span>
      </div>
    </div>
  </div>
</section>

<script>
  const texts = ["Support Teams", "Sales Teams", "HR Teams", "IT Helpdesk", "Knowledge Base"];
  let currentIndex = 0;
  const element = document.getElementById('rotating-text');
  
  function rotateText() {
    if (element) {
      element.style.opacity = '0';
      element.style.transform = 'translateY(10px)';
      
      setTimeout(() => {
        currentIndex = (currentIndex + 1) % texts.length;
        element.textContent = texts[currentIndex];
        element.style.opacity = '1';
        element.style.transform = 'translateY(0)';
      }, 300);
    }
  }
  
  if (element) {
    element.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
    setInterval(rotateText, 3000);
  }
</script>
