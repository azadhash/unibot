---
const rotatingTexts = [
  "Support Teams",
  "Sales Teams",
  "HR Teams",
  "IT Helpdesk",
  "Knowledge Base",
];
---

<section
  class="relative min-h-screen flex items-center justify-center overflow-hidden bg-[#050507]"
>
  <!-- Grain Overlay -->
  <div class="grain-overlay"></div>

  <!-- Cosmic Orb Backgrounds -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="cosmic-orb cosmic-orb-coral w-[600px] h-[600px] -top-40 -left-40 opacity-40"
    >
    </div>
    <div
      class="cosmic-orb cosmic-orb-violet w-[500px] h-[500px] top-1/3 right-0 opacity-30"
      style="animation-delay: -5s;"
    >
    </div>
    <div
      class="cosmic-orb cosmic-orb-amber w-[400px] h-[400px] bottom-0 left-1/3 opacity-25"
      style="animation-delay: -10s;"
    >
    </div>
  </div>

  <!-- Grid Pattern -->
  <div class="grid-pattern opacity-50"></div>

  <!-- Floating Decorative Elements -->
  <div class="absolute inset-0 pointer-events-none">
    <!-- Floating circles -->
    <div
      class="absolute top-1/4 left-[15%] w-2 h-2 rounded-full bg-[#ff6b4a]/40"
      style="animation: float-medium 6s ease-in-out infinite;"
    >
    </div>
    <div
      class="absolute top-1/3 right-[20%] w-3 h-3 rounded-full bg-[#9f7aea]/40"
      style="animation: float-medium 8s ease-in-out infinite; animation-delay: -2s;"
    >
    </div>
    <div
      class="absolute bottom-1/3 left-[25%] w-1.5 h-1.5 rounded-full bg-[#ffa94d]/50"
      style="animation: float-medium 7s ease-in-out infinite; animation-delay: -4s;"
    >
    </div>
    <div
      class="absolute top-1/2 right-[10%] w-2.5 h-2.5 rounded-full bg-[#22d3ee]/30"
      style="animation: float-medium 9s ease-in-out infinite; animation-delay: -3s;"
    >
    </div>

    <!-- Decorative lines -->
    <div
      class="absolute top-1/4 left-1/4 w-px h-32 bg-gradient-to-b from-transparent via-[#ff6b4a]/20 to-transparent"
    >
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-px h-40 bg-gradient-to-b from-transparent via-[#9f7aea]/20 to-transparent"
    >
    </div>
  </div>

  <div class="container-premium pt-44 pb-24 lg:pt-48 lg:pb-32 relative z-10">
    <!-- Centered Hero Content -->
    <div class="text-center max-w-5xl mx-auto mb-16 lg:mb-20">
      <!-- Announcement Badge -->
      <div class="animate-fade-up mb-8">
        <span class="announcement-premium">
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
          <span>Powered by the latest AI models</span>
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"></path>
          </svg>
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="heading-display mb-8 animate-fade-up delay-100">
        <span class="block">Build AI Chatbots for</span>
        <span
          id="rotating-text"
          class="gradient-text-luminous inline-block min-w-[200px]"
          >Support Teams</span
        >
      </h1>

      <!-- Subheadline -->
      <p
        class="body-large max-w-2xl mx-auto mb-12 animate-fade-up delay-200 text-[#9898a8]"
      >
        Create custom AI chatbots for customer support and internal teams. Train
        on your data and embed anywhere in minutes — no coding required.
      </p>

      <!-- CTA Buttons -->
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-up delay-300"
      >
        <a href="#book-demo" class="btn-luminous group">
          <span class="flex items-center gap-2">
            Get a Demo
            <svg
              class="w-5 h-5 transform group-hover:translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </span>
        </a>
        <a href="#how-it-works" class="btn-ghost group">
          <span class="flex items-center gap-2">
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            See How It Works
          </span>
        </a>
      </div>
    </div>

    <!-- Chat Preview Window -->
    <div class="max-w-2xl mx-auto animate-fade-up delay-400">
      <div class="relative">
        <!-- Glow effect behind window -->
        <div
          class="absolute -inset-8 bg-gradient-to-r from-[#ff6b4a]/20 via-[#ffa94d]/15 to-[#9f7aea]/20 rounded-3xl blur-3xl opacity-60"
        >
        </div>

        <!-- macOS Window -->
        <div class="relative macos-window-premium glow-coral">
          <!-- Title bar -->
          <div class="macos-titlebar-premium">
            <div class="macos-dot macos-dot-red"></div>
            <div class="macos-dot macos-dot-yellow"></div>
            <div class="macos-dot macos-dot-green"></div>
            <span
              class="ml-4 text-sm text-[#6b6b7a]"
              style="font-family: 'Satoshi', sans-serif;">UniBot Assistant</span
            >
            <div class="ml-auto flex items-center gap-2">
              <span class="w-2 h-2 bg-[#ff6b4a] rounded-full animate-pulse"
              ></span>
              <span class="text-xs text-[#6b6b7a]">Online</span>
            </div>
          </div>

          <!-- Chat content -->
          <div class="p-6 space-y-4 bg-[#0c0c0f]">
            <!-- User message -->
            <div class="flex justify-end animate-fade-up delay-500">
              <div
                class="bg-gradient-to-r from-[#ff6b4a]/20 to-[#ffa94d]/20 border border-[#ff6b4a]/20 rounded-2xl rounded-tr-sm px-4 py-3 max-w-[80%]"
              >
                <p class="text-sm text-white">
                  How do I integrate your API with my platform?
                </p>
              </div>
            </div>

            <!-- Bot response -->
            <div class="flex justify-start animate-fade-up delay-600">
              <div
                class="bg-[#111115] border border-[#1f1f28] rounded-2xl rounded-tl-sm px-4 py-3 max-w-[80%]"
              >
                <p class="text-sm text-[#c4c4d0] mb-2">
                  Great question! Here's how to integrate our API:
                </p>
                <ol class="text-sm text-[#8b8b9a] space-y-1.5">
                  <li class="flex items-start gap-2">
                    <span class="text-[#ff6b4a]">1.</span>
                    Generate an API key from your dashboard
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-[#ff6b4a]">2.</span>
                    Install our SDK: <code
                      class="px-1.5 py-0.5 bg-[#1a1a1f] rounded text-[#ffa94d]"
                      >npm install unibot-sdk</code
                    >
                  </li>
                  <li class="flex items-start gap-2">
                    <span class="text-[#ff6b4a]">3.</span>
                    Initialize with your key...
                  </li>
                </ol>
              </div>
            </div>

            <!-- User message -->
            <div class="flex justify-end animate-fade-up delay-700">
              <div
                class="bg-gradient-to-r from-[#ff6b4a]/20 to-[#ffa94d]/20 border border-[#ff6b4a]/20 rounded-2xl rounded-tr-sm px-4 py-3 max-w-[80%]"
              >
                <p class="text-sm text-white">
                  That's exactly what I needed! 🎉
                </p>
              </div>
            </div>
          </div>

          <!-- Input area -->
          <div class="px-6 pb-6 bg-[#0c0c0f]">
            <div
              class="flex items-center gap-3 bg-[#111115] border border-[#1f1f28] rounded-xl px-4 py-3.5"
            >
              <svg
                class="w-5 h-5 text-[#6b6b7a]"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"
                ></path>
              </svg>
              <span class="text-sm text-[#6b6b7a]">Type your message...</span>
              <button
                class="ml-auto p-2.5 bg-gradient-to-r from-[#ff6b4a] to-[#ffa94d] rounded-lg hover:opacity-90 transition-opacity"
              >
                <svg
                  class="w-4 h-4 text-[#050507]"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Trust Indicators -->
    <div class="mt-20 lg:mt-24 text-center animate-fade-up delay-500">
      <p
        class="text-sm text-[#6b6b7a] mb-8 uppercase tracking-wider font-medium"
        style="font-family: 'Syne', sans-serif;"
      >
        Trusted by innovative companies worldwide
      </p>
      <div
        class="flex items-center justify-center gap-8 md:gap-16 flex-wrap opacity-50"
      >
        <span
          class="text-lg font-semibold text-[#8b8b9a]"
          style="font-family: 'Syne', sans-serif;">Acme Inc</span
        >
        <span
          class="text-lg font-semibold text-[#8b8b9a]"
          style="font-family: 'Syne', sans-serif;">TechCorp</span
        >
        <span
          class="text-lg font-semibold text-[#8b8b9a]"
          style="font-family: 'Syne', sans-serif;">StartupXY</span
        >
        <span
          class="text-lg font-semibold text-[#8b8b9a] hidden md:block"
          style="font-family: 'Syne', sans-serif;">DataFlow</span
        >
        <span
          class="text-lg font-semibold text-[#8b8b9a] hidden lg:block"
          style="font-family: 'Syne', sans-serif;">ByteScale</span
        >
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div
    class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-fade-in delay-700"
  >
    <a
      href="#how-it-works"
      class="flex flex-col items-center gap-2 text-[#6b6b7a] hover:text-[#ff6b4a] transition-colors group"
    >
      <span
        class="text-xs uppercase tracking-widest font-medium"
        style="font-family: 'Syne', sans-serif;">Scroll</span
      >
      <div
        class="w-6 h-10 rounded-full border border-[#2a2a35] flex items-start justify-center p-2 group-hover:border-[#ff6b4a]/40 transition-colors"
      >
        <div class="w-1 h-2 bg-[#ff6b4a] rounded-full animate-bounce"></div>
      </div>
    </a>
  </div>
</section>

<script>
  const texts = [
    "Support Teams",
    "Sales Teams",
    "HR Teams",
    "IT Helpdesk",
    "Knowledge Base",
  ];
  let currentIndex = 0;
  const element = document.getElementById("rotating-text");

  function rotateText() {
    if (element) {
      element.style.opacity = "0";
      element.style.transform = "translateY(10px)";

      setTimeout(() => {
        currentIndex = (currentIndex + 1) % texts.length;
        element.textContent = texts[currentIndex];
        element.style.opacity = "1";
        element.style.transform = "translateY(0)";
      }, 300);
    }
  }

  if (element) {
    element.style.transition = "opacity 0.3s ease, transform 0.3s ease";
    setInterval(rotateText, 3000);
  }
</script>
