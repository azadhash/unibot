---
---

<section id="security" class="section-padding bg-[var(--color-secondary)] bg-opacity-30">
  <div class="container-narrow mx-auto">
    <div class="text-center mb-16 animate-on-scroll">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-green-500 bg-opacity-10 border border-green-500 border-opacity-20 mb-6">
        <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
        </svg>
        <span class="text-sm font-medium text-green-700">Enterprise-Grade Security</span>
      </div>
      <h2 class="heading-lg mb-4">
        Your Data is <span class="gradient-text">Safe With Us</span>
      </h2>
      <p class="body-lg max-w-2xl mx-auto">
        We take security seriously. Your company's data is encrypted, private, and never shared with third parties.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- End-to-End Encryption -->
      <div class="animate-on-scroll delay-100">
        <div class="glass-card rounded-2xl p-6 text-center h-full">
          <div class="w-12 h-12 rounded-xl bg-green-500 bg-opacity-10 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-[var(--color-foreground)] mb-2">End-to-End Encryption</h3>
          <p class="text-sm text-[var(--color-muted-foreground)]">All data is encrypted at rest and in transit using AES-256 encryption.</p>
        </div>
      </div>

      <!-- SOC 2 Compliant -->
      <div class="animate-on-scroll delay-200">
        <div class="glass-card rounded-2xl p-6 text-center h-full">
          <div class="w-12 h-12 rounded-xl bg-green-500 bg-opacity-10 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-[var(--color-foreground)] mb-2">SOC 2 Compliant</h3>
          <p class="text-sm text-[var(--color-muted-foreground)]">Our infrastructure meets the highest security standards and compliance requirements.</p>
        </div>
      </div>

      <!-- Data Privacy First -->
      <div class="animate-on-scroll delay-300">
        <div class="glass-card rounded-2xl p-6 text-center h-full">
          <div class="w-12 h-12 rounded-xl bg-green-500 bg-opacity-10 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-[var(--color-foreground)] mb-2">Data Privacy First</h3>
          <p class="text-sm text-[var(--color-muted-foreground)]">Your data is never used to train our models. It stays completely private to you.</p>
        </div>
      </div>

      <!-- Secure Infrastructure -->
      <div class="animate-on-scroll delay-400">
        <div class="glass-card rounded-2xl p-6 text-center h-full">
          <div class="w-12 h-12 rounded-xl bg-green-500 bg-opacity-10 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-[var(--color-foreground)] mb-2">Secure Infrastructure</h3>
          <p class="text-sm text-[var(--color-muted-foreground)]">Hosted on enterprise-grade cloud infrastructure with 99.9% uptime SLA.</p>
        </div>
      </div>
    </div>
  </div>
</section>
