---
const securityFeatures = [
  {
    title: "End-to-End Encryption",
    description:
      "All data is encrypted at rest and in transit using AES-256 encryption.",
    icon: "lock",
  },
  {
    title: "Data Privacy First",
    description:
      "Your data is never used to train our models. It stays completely private to you.",
    icon: "eye",
  },
  {
    title: "Secure Infrastructure",
    description:
      "Hosted on enterprise-grade cloud infrastructure with 99.9% uptime SLA.",
    icon: "server",
  },
];
---

<section id="security" class="section-cosmic bg-[#0a0a0d] relative">
  <!-- Background Effects -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="cosmic-orb cosmic-orb-violet w-[500px] h-[500px] top-0 left-1/4 opacity-15"
    >
    </div>
  </div>

  <!-- Grid Pattern -->
  <div class="grid-pattern opacity-30"></div>

  <div class="container-premium relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-16 animate-fade-up">
      <span class="status-pill mb-6 inline-flex">
        <span class="status-pill-dot"></span>
        All systems normal
      </span>
      <h2 class="heading-section mb-6">
        Your Data is <span class="gradient-text-cool">Safe With Us</span>
      </h2>
      <p class="body-large max-w-2xl mx-auto text-[#8b8b9a]">
        We take security seriously. Your company's data is encrypted, private,
        and never shared with third parties.
      </p>
    </div>

    <!-- Security Cards -->
    <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      <!-- Encryption -->
      <div class="animate-fade-up delay-100">
        <div class="crystal-card rounded-2xl p-8 text-center h-full">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#22d3ee]/15 to-[#9f7aea]/15 border border-[#22d3ee]/20 flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-7 h-7 text-[#22d3ee]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
              ></path>
            </svg>
          </div>
          <h3 class="heading-card mb-3">{securityFeatures[0].title}</h3>
          <p class="body-regular text-[#8b8b9a]">
            {securityFeatures[0].description}
          </p>
        </div>
      </div>

      <!-- Privacy -->
      <div class="animate-fade-up delay-200">
        <div class="crystal-card rounded-2xl p-8 text-center h-full">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#9f7aea]/15 to-[#f472b6]/15 border border-[#9f7aea]/20 flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-7 h-7 text-[#9f7aea]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
              ></path>
            </svg>
          </div>
          <h3 class="heading-card mb-3">{securityFeatures[1].title}</h3>
          <p class="body-regular text-[#8b8b9a]">
            {securityFeatures[1].description}
          </p>
        </div>
      </div>

      <!-- Infrastructure -->
      <div class="animate-fade-up delay-300">
        <div class="crystal-card rounded-2xl p-8 text-center h-full">
          <div
            class="w-14 h-14 rounded-2xl bg-gradient-to-br from-[#3b82f6]/15 to-[#22d3ee]/15 border border-[#3b82f6]/20 flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-7 h-7 text-[#3b82f6]"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"
              ></path>
            </svg>
          </div>
          <h3 class="heading-card mb-3">{securityFeatures[2].title}</h3>
          <p class="body-regular text-[#8b8b9a]">
            {securityFeatures[2].description}
          </p>
        </div>
      </div>
    </div>

    <!-- Certifications Bar -->
    <div class="mt-16 text-center animate-fade-up delay-400">
      <p
        class="text-sm text-[#6b6b7a] mb-6 uppercase tracking-wider font-medium"
        style="font-family: 'Syne', sans-serif;"
      >
        Compliance & Certifications
      </p>
      <div class="flex items-center justify-center gap-6 md:gap-10 flex-wrap">
        <span
          class="px-4 py-2 bg-[#111115] border border-[#1f1f28] rounded-lg text-[#8b8b9a] text-sm font-medium"
          >SOC 2 Type II</span
        >
        <span
          class="px-4 py-2 bg-[#111115] border border-[#1f1f28] rounded-lg text-[#8b8b9a] text-sm font-medium"
          >GDPR</span
        >
        <span
          class="px-4 py-2 bg-[#111115] border border-[#1f1f28] rounded-lg text-[#8b8b9a] text-sm font-medium"
          >HIPAA</span
        >
        <span
          class="px-4 py-2 bg-[#111115] border border-[#1f1f28] rounded-lg text-[#8b8b9a] text-sm font-medium"
          >ISO 27001</span
        >
      </div>
    </div>
  </div>
</section>
