---
---

<section id="security" class="section-padding bg-black relative">
  <!-- Blueprint grid -->
  <div class="absolute inset-0 pointer-events-none opacity-30">
    <div class="h-full w-px border-l border-dashed border-zinc-700 absolute left-1/4"></div>
    <div class="h-full w-px border-l border-dashed border-zinc-700 absolute left-1/2"></div>
    <div class="h-full w-px border-l border-dashed border-zinc-700 absolute left-3/4"></div>
  </div>

  <div class="container-narrow mx-auto relative z-10">
    <div class="text-center mb-16 animate-on-scroll">
      <div class="status-indicator mb-6 inline-flex">
        <span class="status-dot"></span>
        <span>All systems normal</span>
      </div>
      <h2 class="heading-lg mb-4">
        Your Data is <span class="gradient-text">Safe With Us</span>
      </h2>
      <p class="body-lg max-w-2xl mx-auto text-zinc-400">
        We take security seriously. Your company's data is encrypted, private, and never shared with third parties.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <!-- End-to-End Encryption -->
      <div class="animate-on-scroll delay-100">
        <div class="glass-card rounded-xl p-6 text-center h-full">
          <div class="w-12 h-12 rounded-xl bg-green-500/10 border border-green-500/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2">End-to-End Encryption</h3>
          <p class="text-sm text-zinc-400">All data is encrypted at rest and in transit using AES-256 encryption.</p>
        </div>
      </div>

      <!-- Data Privacy First -->
      <div class="animate-on-scroll delay-200">
        <div class="glass-card rounded-xl p-6 text-center h-full">
          <div class="w-12 h-12 rounded-xl bg-green-500/10 border border-green-500/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2">Data Privacy First</h3>
          <p class="text-sm text-zinc-400">Your data is never used to train our models. It stays completely private to you.</p>
        </div>
      </div>

      <!-- Secure Infrastructure -->
      <div class="animate-on-scroll delay-300">
        <div class="glass-card rounded-xl p-6 text-center h-full">
          <div class="w-12 h-12 rounded-xl bg-green-500/10 border border-green-500/20 flex items-center justify-center mx-auto mb-4">
            <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"></path>
            </svg>
          </div>
          <h3 class="font-semibold text-white mb-2">Secure Infrastructure</h3>
          <p class="text-sm text-zinc-400">Hosted on enterprise-grade cloud infrastructure with 99.9% uptime SLA.</p>
        </div>
      </div>
    </div>
  </div>
</section>
