---
const navLinks = [
  { href: "#features", label: "Features" },
  { href: "#how-it-works", label: "How It Works" },
  { href: "#pricing", label: "Pricing" },
  { href: "#security", label: "Security" },
  { href: "#faq", label: "FAQ" },
];
---

<header id="main-header" class="fixed top-0 left-0 right-0 z-50">
  <!-- Announcement Bar -->
  <div class="border-b border-white/5 backdrop-blur-xl bg-[#050507]/80">
    <div class="container-premium py-2.5">
      <a
        href="#book-demo"
        class="flex items-center justify-center gap-3 text-sm text-[#c4c4d0] hover:text-white transition-colors group"
      >
        <span
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gradient-to-r from-[#ff6b4a]/10 to-[#9f7aea]/10 border border-[#ff6b4a]/20"
        >
          <span class="w-2 h-2 rounded-full bg-[#ff6b4a] animate-pulse"></span>
          <span
            class="text-[#ff6b4a] font-semibold text-xs uppercase tracking-wider"
            >New</span
          >
        </span>
        <span class="font-medium"
          >Book a personalized demo and see UniBot in action</span
        >
        <svg
          class="w-4 h-4 transform group-hover:translate-x-1 transition-transform"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>

  <!-- Main Header -->
  <div class="border-b border-white/5 backdrop-blur-xl bg-[#050507]/90">
    <div class="container-premium">
      <div class="flex items-center justify-between h-18 md:h-20">
        <!-- Logo -->
        <a href="#" class="flex items-center gap-3 group">
          <div class="relative">
            <div
              class="absolute inset-0 bg-gradient-to-r from-[#ff6b4a] to-[#ffa94d] blur-lg opacity-50 group-hover:opacity-70 transition-opacity rounded-xl"
            >
            </div>
            <img
              src="/logo.svg"
              alt="UniBot"
              class="relative w-9 h-9 rounded-xl"
            />
          </div>
          <span
            class="text-xl font-bold text-white tracking-tight"
            style="font-family: 'Syne', sans-serif;">UniBot</span
          >
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-1">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="px-5 py-2.5 text-[14px] font-medium text-[#8b8b9a] hover:text-white transition-all duration-300 rounded-xl hover:bg-white/5"
                style="font-family: 'Satoshi', sans-serif;"
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <!-- CTA Button -->
        <div class="hidden md:flex items-center gap-4">
          <a
            href="#book-demo"
            class="btn-luminous text-sm py-3 px-6 rounded-xl"
          >
            <span>Get a Demo</span>
          </a>
        </div>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-btn"
          class="md:hidden p-2 text-white rounded-xl hover:bg-white/5 transition-colors"
          aria-label="Toggle menu"
        >
          <svg
            id="menu-icon"
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            id="close-icon"
            class="w-6 h-6 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Menu -->
      <div
        id="mobile-menu"
        class="md:hidden hidden py-6 border-t border-white/5"
      >
        <nav class="flex flex-col gap-2">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="mobile-nav-link px-4 py-3 text-[#8b8b9a] hover:text-white hover:bg-white/5 transition-all duration-300 text-base font-medium rounded-xl"
              >
                {link.label}
              </a>
            ))
          }
          <a
            href="#book-demo"
            class="btn-luminous text-center mt-4 py-3.5 px-6 rounded-xl"
          >
            <span>Get a Demo</span>
          </a>
        </nav>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIcon = document.getElementById("menu-icon");
  const closeIcon = document.getElementById("close-icon");

  mobileMenuBtn?.addEventListener("click", () => {
    mobileMenu?.classList.toggle("hidden");
    menuIcon?.classList.toggle("hidden");
    closeIcon?.classList.toggle("hidden");
  });

  // Close mobile menu when clicking a link
  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu?.classList.add("hidden");
      menuIcon?.classList.remove("hidden");
      closeIcon?.classList.add("hidden");
    });
  });
</script>
