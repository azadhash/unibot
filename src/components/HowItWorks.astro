---
---

<section id="how-it-works" class="section-padding bg-zinc-950 relative">
  <!-- Blueprint grid -->
  <div class="absolute inset-0 pointer-events-none opacity-30">
    <div class="h-full w-px border-l border-dashed border-zinc-700 absolute left-1/4"></div>
    <div class="h-full w-px border-l border-dashed border-zinc-700 absolute left-1/2"></div>
    <div class="h-full w-px border-l border-dashed border-zinc-700 absolute left-3/4"></div>
  </div>

  <div class="container-narrow mx-auto relative z-10">
    <div class="text-center mb-16 animate-on-scroll">
      <h2 class="heading-lg mb-4">
        How It <span class="gradient-text">Works</span>
      </h2>
      <p class="body-lg max-w-2xl mx-auto text-zinc-400">
        Get your AI chatbot up and running in three simple steps. No coding required.
      </p>
    </div>

    <div class="relative">
      <!-- Connection line -->
      <div class="hidden lg:block absolute top-1/2 left-0 right-0 h-px bg-gradient-to-r from-transparent via-zinc-700 to-transparent -translate-y-1/2 z-0"></div>

      <div class="grid md:grid-cols-3 gap-8 relative z-10">
        <!-- Step 1: Upload Your Data -->
        <div class="relative animate-on-scroll delay-100">
          <div class="glass-card rounded-xl p-8 text-center h-full">
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-green-500 flex items-center justify-center text-sm font-bold text-black">1</div>
            <div class="w-16 h-16 rounded-xl bg-zinc-800 border border-zinc-700 flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path>
              </svg>
            </div>
            <h3 class="heading-md mb-3">Upload Your Data</h3>
            <p class="body-md text-zinc-400">Connect your documents, PDFs, APIs, Notion pages, or knowledge base. We support all major formats.</p>
          </div>
        </div>

        <!-- Step 2: We Train Your AI -->
        <div class="relative animate-on-scroll delay-200">
          <div class="glass-card rounded-xl p-8 text-center h-full">
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-green-500 flex items-center justify-center text-sm font-bold text-black">2</div>
            <div class="w-16 h-16 rounded-xl bg-zinc-800 border border-zinc-700 flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </div>
            <h3 class="heading-md mb-3">We Train Your AI</h3>
            <p class="body-md text-zinc-400">Our AI learns from your data and understands your business context, products, and services.</p>
          </div>
        </div>

        <!-- Step 3: Embed & Go Live -->
        <div class="relative animate-on-scroll delay-300">
          <div class="glass-card rounded-xl p-8 text-center h-full">
            <div class="absolute -top-4 left-1/2 -translate-x-1/2 w-8 h-8 rounded-full bg-green-500 flex items-center justify-center text-sm font-bold text-black">3</div>
            <div class="w-16 h-16 rounded-xl bg-zinc-800 border border-zinc-700 flex items-center justify-center mx-auto mb-6">
              <svg class="w-8 h-8 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
              </svg>
            </div>
            <h3 class="heading-md mb-3">Embed & Go Live</h3>
            <p class="body-md text-zinc-400">Copy-paste a simple embed code into your website. Your AI chatbot is ready to help customers.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
