---
const links = {
  product: [
    { href: "#features", label: "Features" },
    { href: "#how-it-works", label: "How It Works" },
    { href: "#security", label: "Security" },
    { href: "#faq", label: "FAQ" },
  ],
  company: [
    { href: "/about", label: "About" },
    { href: "/blog", label: "Blog" },
    { href: "/careers", label: "Careers" },
    { href: "mailto:hello@unibot.in", label: "Contact" },
  ],
  legal: [
    { href: "/privacy", label: "Privacy Policy" },
    { href: "/terms", label: "Terms of Service" },
    { href: "/cookies", label: "Cookie Policy" },
  ],
};

const currentYear = new Date().getFullYear();
---

<footer class="bg-[#050507] border-t border-[#1f1f28] relative overflow-hidden">
  <!-- Subtle background -->
  <div class="absolute inset-0 pointer-events-none">
    <div
      class="cosmic-orb cosmic-orb-coral w-[400px] h-[400px] -bottom-60 -left-40 opacity-10"
    >
    </div>
  </div>

  <div class="container-premium py-16 lg:py-20 relative z-10">
    <div class="grid md:grid-cols-2 lg:grid-cols-5 gap-12 lg:gap-10 mb-16">
      <!-- Brand -->
      <div class="lg:col-span-2">
        <a href="#" class="flex items-center gap-3 group mb-6">
          <div class="relative">
            <div
              class="absolute inset-0 bg-gradient-to-r from-[#ff6b4a] to-[#ffa94d] blur-lg opacity-50 group-hover:opacity-70 transition-opacity rounded-xl"
            >
            </div>
            <img
              src="/logo.svg"
              alt="UniBot"
              class="relative w-10 h-10 rounded-xl"
            />
          </div>
          <span
            class="text-2xl font-bold text-white tracking-tight"
            style="font-family: 'Syne', sans-serif;">UniBot</span
          >
        </a>
        <p class="text-[#8b8b9a] text-base max-w-sm mb-8 leading-relaxed">
          Your universal AI assistant for every question. Provide instant,
          accurate support to your customers 24/7.
        </p>
        <a href="#book-demo" class="btn-luminous inline-flex text-sm py-3 px-6">
          <span>Book a Demo</span>
        </a>
      </div>

      <!-- Product links -->
      <div>
        <h4
          class="font-bold text-white mb-5"
          style="font-family: 'Syne', sans-serif;"
        >
          Product
        </h4>
        <ul class="space-y-4">
          {
            links.product.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[#8b8b9a] hover:text-[#ff6b4a] transition-colors duration-300"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Company links -->
      <div>
        <h4
          class="font-bold text-white mb-5"
          style="font-family: 'Syne', sans-serif;"
        >
          Company
        </h4>
        <ul class="space-y-4">
          {
            links.company.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[#8b8b9a] hover:text-[#ff6b4a] transition-colors duration-300"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Legal links -->
      <div>
        <h4
          class="font-bold text-white mb-5"
          style="font-family: 'Syne', sans-serif;"
        >
          Legal
        </h4>
        <ul class="space-y-4">
          {
            links.legal.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-[#8b8b9a] hover:text-[#ff6b4a] transition-colors duration-300"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Divider -->
    <div class="divider-gradient mb-10"></div>

    <!-- Bottom bar -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex items-center gap-6 flex-wrap justify-center">
        <p class="text-sm text-[#6b6b7a]">
          © {currentYear} UniBot. All rights reserved.
        </p>
        <!-- Status indicator -->
        <div class="status-pill text-xs py-1.5 px-3">
          <span class="w-1.5 h-1.5 rounded-full bg-[#ff6b4a]"></span>
          <span>All systems normal</span>
        </div>
      </div>

      <div class="flex items-center gap-5">
        <!-- Twitter/X -->
        <a
          href="#"
          class="w-10 h-10 rounded-xl bg-[#111115] border border-[#1f1f28] flex items-center justify-center text-[#6b6b7a] hover:text-[#ff6b4a] hover:border-[#ff6b4a]/30 transition-all"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"
            ></path>
          </svg>
        </a>
        <!-- GitHub -->
        <a
          href="#"
          class="w-10 h-10 rounded-xl bg-[#111115] border border-[#1f1f28] flex items-center justify-center text-[#6b6b7a] hover:text-[#ff6b4a] hover:border-[#ff6b4a]/30 transition-all"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
        <!-- LinkedIn -->
        <a
          href="#"
          class="w-10 h-10 rounded-xl bg-[#111115] border border-[#1f1f28] flex items-center justify-center text-[#6b6b7a] hover:text-[#ff6b4a] hover:border-[#ff6b4a]/30 transition-all"
        >
          <svg
            class="w-5 h-5"
            fill="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
