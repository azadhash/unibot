---
const benefits = [
  { icon: "video", text: "Live product demo" },
  { icon: "clock", text: "30-minute session" },
  { icon: "calendar", text: "Pick your time" },
];
---

<section id="book-demo" class="section-cosmic bg-[#050507] relative">
  <!-- Background Effects -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div
      class="cosmic-orb cosmic-orb-coral w-[600px] h-[600px] -bottom-60 right-0 opacity-20"
    >
    </div>
    <div
      class="cosmic-orb cosmic-orb-amber w-[400px] h-[400px] top-20 -left-40 opacity-15"
      style="animation-delay: -5s;"
    >
    </div>
  </div>

  <!-- Grid Pattern -->
  <div class="grid-pattern opacity-30"></div>

  <div class="container-premium relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-14 animate-fade-up">
      <span class="announcement-premium mb-6 inline-flex">
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
          ></path>
        </svg>
        Schedule a Call
      </span>
      <h2 class="heading-section mb-6">
        See UniBot in Action — <br class="hidden sm:block" />
        <span class="gradient-text-luminous">Book a Live Demo</span>
      </h2>
      <p class="body-large max-w-2xl mx-auto text-[#8b8b9a] mb-10">
        Get a personalized walkthrough of UniBot and see how it can transform
        your customer support.
      </p>

      <!-- Benefits Pills -->
      <div class="flex flex-wrap justify-center gap-4 mb-12">
        <div
          class="flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-[#111115] border border-[#1f1f28] animate-fade-up delay-100"
        >
          <svg
            class="w-4.5 h-4.5 text-[#ff6b4a]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
            ></path>
          </svg>
          <span class="text-sm font-medium text-[#c4c4d0]"
            >Live product demo</span
          >
        </div>

        <div
          class="flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-[#111115] border border-[#1f1f28] animate-fade-up delay-200"
        >
          <svg
            class="w-4.5 h-4.5 text-[#ffa94d]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-sm font-medium text-[#c4c4d0]"
            >30-minute session</span
          >
        </div>

        <div
          class="flex items-center gap-2.5 px-5 py-2.5 rounded-full bg-[#111115] border border-[#1f1f28] animate-fade-up delay-300"
        >
          <svg
            class="w-4.5 h-4.5 text-[#9f7aea]"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            ></path>
          </svg>
          <span class="text-sm font-medium text-[#c4c4d0]">Pick your time</span>
        </div>
      </div>
    </div>

    <!-- Calendar Embed -->
    <div class="max-w-4xl mx-auto animate-fade-up delay-300">
      <div class="relative">
        <!-- Glow effect -->
        <div
          class="absolute -inset-6 bg-gradient-to-r from-[#ff6b4a]/15 via-[#ffa94d]/10 to-[#9f7aea]/15 rounded-3xl blur-3xl opacity-60"
        >
        </div>

        <div class="relative macos-window-premium glow-coral overflow-hidden">
          <!-- macOS titlebar -->
          <div class="macos-titlebar-premium">
            <div class="macos-dot macos-dot-red"></div>
            <div class="macos-dot macos-dot-yellow"></div>
            <div class="macos-dot macos-dot-green"></div>
            <span
              class="ml-4 text-sm text-[#6b6b7a]"
              style="font-family: 'Satoshi', sans-serif;"
              >Book a Demo - Cal.com</span
            >
          </div>
          <iframe
            src="https://cal.com/azad-singh?embed=true&layout=month_view&hideEventTypeDetails=false"
            width="100%"
            height="600"
            frameborder="0"
            loading="lazy"
            class="w-full bg-[#0c0c0f]"
            title="Book a Demo"></iframe>
        </div>
      </div>

      <p class="text-center text-sm text-[#6b6b7a] mt-6">
        Can't find a suitable time?{" "}
        <a
          href="mailto:hello@unibot.in"
          class="text-[#ff6b4a] hover:underline font-medium"
        >
          Contact us directly
        </a>
      </p>
    </div>
  </div>
</section>
