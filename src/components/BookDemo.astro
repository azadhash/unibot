---
---

<section id="book-demo" class="section-padding bg-[var(--color-background)]">
  <div class="container-narrow mx-auto">
    <div class="text-center mb-12 animate-on-scroll">
      <h2 class="heading-lg mb-4">
        See UniBot in Action — <span class="gradient-text">Book a Live Demo</span>
      </h2>
      <p class="body-lg max-w-2xl mx-auto mb-8">
        Get a personalized walkthrough of UniBot and see how it can transform your customer support.
      </p>

      <!-- Benefits -->
      <div class="flex flex-wrap justify-center gap-6 mb-12">
        <!-- Live product demo -->
        <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-blue-100 border border-blue-200 animate-on-scroll delay-100">
          <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
          </svg>
          <span class="text-sm font-medium text-[var(--color-foreground)]">Live product demo</span>
        </div>

        <!-- 30-minute session -->
        <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-blue-100 border border-blue-200 animate-on-scroll delay-200">
          <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-sm font-medium text-[var(--color-foreground)]">30-minute session</span>
        </div>

        <!-- Pick your time -->
        <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-blue-100 border border-blue-200 animate-on-scroll delay-300">
          <svg class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <span class="text-sm font-medium text-[var(--color-foreground)]">Pick your time</span>
        </div>
      </div>
    </div>

    <!-- Calendar embed -->
    <div class="max-w-4xl mx-auto animate-on-scroll delay-200">
      <div class="glass-card rounded-2xl overflow-hidden glow-effect">
        <iframe
          src="https://cal.com/azad-singh?embed=true&layout=month_view&hideEventTypeDetails=false"
          width="100%"
          height="600"
          frameborder="0"
          loading="lazy"
          class="w-full"
          title="Book a Demo"
        ></iframe>
      </div>
      <p class="text-center text-sm text-[var(--color-muted-foreground)] mt-4">
        Can't find a suitable time?{" "}
        <a href="mailto:hello@unibot.in" class="text-blue-600 hover:underline">
          Contact us directly
        </a>
      </p>
    </div>
  </div>
</section>
