---
---

<section id="book-demo" class="section-padding bg-zinc-950 relative">
  <!-- Blueprint grid -->
  <div class="absolute inset-0 pointer-events-none opacity-30">
    <div class="h-full w-px border-l border-dashed border-zinc-700 absolute left-1/4"></div>
    <div class="h-full w-px border-l border-dashed border-zinc-700 absolute left-1/2"></div>
    <div class="h-full w-px border-l border-dashed border-zinc-700 absolute left-3/4"></div>
  </div>

  <div class="container-narrow mx-auto relative z-10">
    <div class="text-center mb-12 animate-on-scroll">
      <h2 class="heading-lg mb-4">
        See UniBot in Action — <span class="gradient-text">Book a Live Demo</span>
      </h2>
      <p class="body-lg max-w-2xl mx-auto mb-8 text-zinc-400">
        Get a personalized walkthrough of UniBot and see how it can transform your customer support.
      </p>

      <!-- Benefits -->
      <div class="flex flex-wrap justify-center gap-4 mb-12">
        <!-- Live product demo -->
        <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-zinc-800 border border-zinc-700 animate-on-scroll delay-100">
          <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
          </svg>
          <span class="text-sm font-medium text-zinc-300">Live product demo</span>
        </div>

        <!-- 30-minute session -->
        <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-zinc-800 border border-zinc-700 animate-on-scroll delay-200">
          <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span class="text-sm font-medium text-zinc-300">30-minute session</span>
        </div>

        <!-- Pick your time -->
        <div class="flex items-center gap-2 px-4 py-2 rounded-full bg-zinc-800 border border-zinc-700 animate-on-scroll delay-300">
          <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <span class="text-sm font-medium text-zinc-300">Pick your time</span>
        </div>
      </div>
    </div>

    <!-- Calendar embed -->
    <div class="max-w-4xl mx-auto animate-on-scroll delay-200">
      <div class="macos-window glow-effect overflow-hidden">
        <!-- macOS titlebar -->
        <div class="macos-titlebar">
          <div class="macos-dot macos-dot-red"></div>
          <div class="macos-dot macos-dot-yellow"></div>
          <div class="macos-dot macos-dot-green"></div>
          <span class="ml-4 text-sm text-zinc-500">Book a Demo - Cal.com</span>
        </div>
        <iframe
          src="https://cal.com/azad-singh?embed=true&layout=month_view&hideEventTypeDetails=false"
          width="100%"
          height="600"
          frameborder="0"
          loading="lazy"
          class="w-full bg-black"
          title="Book a Demo"
        ></iframe>
      </div>
      <p class="text-center text-sm text-zinc-500 mt-4">
        Can't find a suitable time?{" "}
        <a href="mailto:hello@unibot.in" class="text-green-400 hover:underline">
          Contact us directly
        </a>
      </p>
    </div>
  </div>
</section>
