---
const benefits = [
  "Answers questions 24/7 without human intervention",
  "Understands context and provides accurate responses",
  "Escalates complex issues to your team automatically",
  "Learns and improves from every conversation",
];
---

<section class="section-padding bg-[var(--color-secondary)] bg-opacity-30 overflow-hidden">
  <div class="container-narrow mx-auto">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left content -->
      <div class="animate-on-scroll">
        <h2 class="heading-lg mb-6">
          See Your <span class="gradient-text">AI in Action</span>
        </h2>
        <p class="body-lg mb-6">
          Your UniBot learns from every piece of content you provide — from help docs to API documentation — and answers customer questions naturally.
        </p>
        
        <ul class="space-y-4 mb-8">
          {benefits.map((item, index) => (
            <li class={`flex items-start gap-3 animate-on-scroll delay-${(index + 1) * 100}`}>
              <div class="w-5 h-5 rounded-full gradient-bg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="body-md">{item}</span>
            </li>
          ))}
        </ul>

        <a href="#book-demo" class="btn-hero inline-flex">
          Try It Yourself
          <svg class="w-5 h-5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Right content - Interactive preview -->
      <div class="relative animate-on-scroll delay-200">
        <!-- Background glow -->
        <div class="absolute inset-0 gradient-bg rounded-3xl blur-3xl opacity-10"></div>
        
        <!-- Chat widget mockup -->
        <div class="relative bg-[var(--color-card)] rounded-2xl shadow-2xl overflow-hidden border border-[var(--color-border)] border-opacity-50">
          <!-- Widget header -->
          <div class="gradient-bg p-4 flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-white bg-opacity-20 flex items-center justify-center">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <p class="font-semibold text-white">UniBot Support</p>
              <p class="text-xs text-white text-opacity-80">Powered by your knowledge base</p>
            </div>
            <div class="ml-auto flex gap-1">
              <div class="w-3 h-3 rounded-full bg-white bg-opacity-30"></div>
              <div class="w-3 h-3 rounded-full bg-white bg-opacity-30"></div>
              <div class="w-3 h-3 rounded-full bg-white bg-opacity-30"></div>
            </div>
          </div>

          <!-- Chat area -->
          <div class="p-4 space-y-4 min-h-[300px] bg-[var(--color-background)]">
            <!-- Bot message -->
            <div class="flex gap-3 animate-on-scroll delay-300">
              <div class="w-8 h-8 rounded-full gradient-bg flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="bg-[var(--color-secondary)] rounded-2xl rounded-tl-sm px-4 py-3 max-w-[85%]">
                <p class="text-sm text-[var(--color-foreground)]">
                  Hi! 👋 I'm your AI assistant trained on your company's data. How can I help you today?
                </p>
              </div>
            </div>

            <!-- User message -->
            <div class="flex justify-end animate-on-scroll delay-400">
              <div class="gradient-bg rounded-2xl rounded-tr-sm px-4 py-3 max-w-[85%]">
                <p class="text-sm text-white">What pricing plans do you offer?</p>
              </div>
            </div>

            <!-- Bot response -->
            <div class="flex gap-3 animate-on-scroll delay-500">
              <div class="w-8 h-8 rounded-full gradient-bg flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="bg-[var(--color-secondary)] rounded-2xl rounded-tl-sm px-4 py-3 max-w-[85%]">
                <p class="text-sm text-[var(--color-foreground)]">
                  We offer three plans tailored to your needs:
                </p>
                <ul class="text-sm text-[var(--color-muted-foreground)] mt-2 space-y-1">
                  <li>🚀 <strong>Starter</strong> - Perfect for small teams</li>
                  <li>💼 <strong>Pro</strong> - For growing businesses</li>
                  <li>🏢 <strong>Enterprise</strong> - Custom solutions</li>
                </ul>
              </div>
            </div>

            <!-- Typing indicator -->
            <div class="flex gap-3">
              <div class="w-8 h-8 rounded-full gradient-bg flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-white animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                </svg>
              </div>
              <div class="bg-[var(--color-secondary)] rounded-2xl px-4 py-3">
                <div class="flex gap-1">
                  <div class="w-2 h-2 rounded-full bg-[var(--color-muted-foreground)] animate-bounce" style="animation-delay: 0ms;"></div>
                  <div class="w-2 h-2 rounded-full bg-[var(--color-muted-foreground)] animate-bounce" style="animation-delay: 150ms;"></div>
                  <div class="w-2 h-2 rounded-full bg-[var(--color-muted-foreground)] animate-bounce" style="animation-delay: 300ms;"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- Input area -->
          <div class="p-4 border-t border-[var(--color-border)] border-opacity-50 bg-[var(--color-card)]">
            <div class="flex items-center gap-3 bg-[var(--color-secondary)] rounded-xl px-4 py-3">
              <input
                type="text"
                placeholder="Type your message..."
                class="flex-1 bg-transparent text-sm outline-none text-[var(--color-foreground)] placeholder:text-[var(--color-muted-foreground)]"
                disabled
              />
              <button class="w-8 h-8 rounded-lg gradient-bg flex items-center justify-center">
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Floating badge -->
        <div class="absolute -bottom-4 -left-4 bg-[var(--color-card)] rounded-xl px-4 py-2 shadow-lg border border-[var(--color-border)] border-opacity-50" style="animation: float 2s ease-in-out infinite;">
          <p class="text-xs text-[var(--color-muted-foreground)]">Response time</p>
          <p class="font-semibold text-[var(--color-foreground)]">~1.2 seconds</p>
        </div>
      </div>
    </div>
  </div>
</section>
