---
const benefits = [
  "Answers questions 24/7 without human intervention",
  "Understands context and provides accurate responses",
  "Escalates complex issues to your team automatically",
  "Learns and improves from every conversation",
];
---

<section class="section-padding bg-zinc-950 relative overflow-hidden">
  <!-- Blueprint grid -->
  <div class="absolute inset-0 pointer-events-none opacity-30">
    <div class="h-full w-px border-l border-dashed border-zinc-700 absolute left-1/4"></div>
    <div class="h-full w-px border-l border-dashed border-zinc-700 absolute left-1/2"></div>
    <div class="h-full w-px border-l border-dashed border-zinc-700 absolute left-3/4"></div>
  </div>

  <div class="container-narrow mx-auto relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left content -->
      <div class="animate-on-scroll">
        <h2 class="heading-lg mb-6">
          See Your <span class="gradient-text">AI in Action</span>
        </h2>
        <p class="body-lg mb-6 text-zinc-400">
          Your UniBot learns from every piece of content you provide — from help docs to API documentation — and answers customer questions naturally.
        </p>
        
        <ul class="space-y-4 mb-8">
          {benefits.map((item, index) => (
            <li class={`flex items-start gap-3 animate-on-scroll delay-${(index + 1) * 100}`}>
              <div class="w-5 h-5 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3 h-3 text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="body-md text-zinc-300">{item}</span>
            </li>
          ))}
        </ul>

        <a href="#book-demo" class="btn-hero inline-flex">
          Try It Yourself
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <!-- Right content - macOS Window Chat Preview -->
      <div class="relative animate-on-scroll delay-200">
        <!-- Background glow -->
        <div class="absolute -inset-4 bg-gradient-to-r from-green-500/20 to-blue-500/20 rounded-2xl blur-2xl opacity-50"></div>
        
        <!-- macOS Window Chat Widget -->
        <div class="relative macos-window glow-effect">
          <!-- Title bar -->
          <div class="macos-titlebar">
            <div class="macos-dot macos-dot-red"></div>
            <div class="macos-dot macos-dot-yellow"></div>
            <div class="macos-dot macos-dot-green"></div>
            <span class="ml-4 text-sm text-zinc-500">UniBot Support</span>
            <div class="ml-auto text-xs text-zinc-600">Powered by your knowledge base</div>
          </div>

          <!-- Chat area -->
          <div class="p-4 space-y-4 min-h-[300px] bg-black">
            <!-- Bot message -->
            <div class="flex gap-3 animate-on-scroll delay-300">
              <div class="w-8 h-8 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="bg-zinc-900 border border-zinc-800 rounded-2xl rounded-tl-sm px-4 py-3 max-w-[85%]">
                <p class="text-sm text-zinc-300">
                  Hi! 👋 I'm your AI assistant trained on your company's data. How can I help you today?
                </p>
              </div>
            </div>

            <!-- User message -->
            <div class="flex justify-end animate-on-scroll delay-400">
              <div class="bg-zinc-800 rounded-2xl rounded-tr-sm px-4 py-3 max-w-[85%]">
                <p class="text-sm text-white">What pricing plans do you offer?</p>
              </div>
            </div>

            <!-- Bot response -->
            <div class="flex gap-3 animate-on-scroll delay-500">
              <div class="w-8 h-8 rounded-full bg-green-500 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="bg-zinc-900 border border-zinc-800 rounded-2xl rounded-tl-sm px-4 py-3 max-w-[85%]">
                <p class="text-sm text-zinc-300">
                  We offer plans tailored to your needs:
                </p>
                <ul class="text-sm text-zinc-500 mt-2 space-y-1">
                  <li>🚀 <strong class="text-zinc-300">Starter</strong> - Perfect for small teams</li>
                  <li>💼 <strong class="text-zinc-300">Pro</strong> - For growing businesses</li>
                  <li>🏢 <strong class="text-zinc-300">Enterprise</strong> - Custom solutions</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Input area -->
          <div class="p-4 border-t border-zinc-800 bg-zinc-950">
            <div class="flex items-center gap-3 bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-3">
              <span class="flex-1 text-sm text-zinc-600">Type your message...</span>
              <button class="p-2 bg-green-500 rounded-lg hover:bg-green-400 transition-colors">
                <svg class="w-4 h-4 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Floating badge -->
        <div class="absolute -bottom-4 -left-4 bg-zinc-900 border border-zinc-800 rounded-xl px-4 py-2 shadow-lg" style="animation: float 2s ease-in-out infinite;">
          <p class="text-xs text-zinc-500">Response time</p>
          <p class="font-semibold text-green-400">~1.2 seconds</p>
        </div>
      </div>
    </div>
  </div>
</section>
