---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title = "UniBot - Build AI Chatbots for Support & Teams | No-Code AI Platform",
  description = "Create custom AI chatbots for customer support and internal teams. Train on your data, embed anywhere, and automate responses 24/7. No coding required. Start free today!",
  keywords = "AI chatbot, customer support chatbot, AI assistant, chatbot builder, no-code chatbot, knowledge base AI, customer service automation, team chatbot, business AI, UniBot",
  canonicalUrl = "https://unibot.in",
  ogImage = "https://unibot.in/og-image.png",
} = Astro.props;

// Structured data for Organization
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "UniBot",
  url: "https://unibot.in",
  logo: "https://unibot.in/logo.svg",
  description:
    "UniBot helps businesses create custom AI chatbots for customer support and internal teams.",
  sameAs: ["https://twitter.com/UniBot", "https://linkedin.com/company/unibot"],
  contactPoint: {
    "@type": "ContactPoint",
    email: "hello@unibot.in",
    contactType: "customer support",
  },
};

// Structured data for SoftwareApplication
const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "UniBot",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
    description: "Free trial available",
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.8",
    ratingCount: "150",
    bestRating: "5",
  },
  description:
    "AI-powered chatbot platform for customer support and internal teams. Train on your data and embed anywhere.",
  url: "https://unibot.in",
};

// Breadcrumb structured data for better navigation in search
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://unibot.in",
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="UniBot" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta name="googlebot" content="index, follow" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Alternate language (if applicable) -->
    <link rel="alternate" hreflang="en" href="https://unibot.in" />
    <link rel="alternate" hreflang="x-default" href="https://unibot.in" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="UniBot - AI Chatbot Platform" />
    <meta property="og:site_name" content="UniBot" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@UniBot" />
    <meta name="twitter:creator" content="@UniBot" />

    <!-- Additional SEO Meta Tags -->
    <meta name="theme-color" content="#ff6b4a" />
    <meta name="msapplication-TileColor" content="#ff6b4a" />
    <meta name="application-name" content="UniBot" />
    <meta name="apple-mobile-web-app-title" content="UniBot" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="black-translucent"
    />

    <!-- Geo Meta Tags (if targeting specific regions) -->
    <meta name="geo.region" content="IN" />
    <meta name="geo.placename" content="India" />

    <!-- Structured Data -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(softwareSchema)}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema)}
    />

    <!-- Fonts - Syne (Display) + Satoshi (Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logo.svg" />

    <!-- Custom cursor styling -->
    <style>
      /* Smooth scrolling on the entire page */
      html {
        scroll-behavior: smooth;
      }

      /* Preload animation prevention */
      .preload * {
        transition: none !important;
      }
    </style>
  </head>
  <body class="grain-overlay">
    <slot />

    <script>
      // Remove preload class after page loads to enable transitions
      document.addEventListener("DOMContentLoaded", () => {
        document.body.classList.remove("preload");
      });
    </script>
  </body>
</html>
